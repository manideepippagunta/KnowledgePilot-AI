# KnowledgePilot AI — Environment Template
# Copy to .env and fill in real values. Never commit .env to source control.
# Real secrets must come from environment variables / secret manager in production.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Runtime environment: development | staging | production | test
KNOWLEDGEPILOT_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
KNOWLEDGEPILOT_LOG_LEVEL=INFO

# Future API server bind address (not used in Phase 1)
KNOWLEDGEPILOT_HOST=127.0.0.1
KNOWLEDGEPILOT_PORT=8000

# ---------------------------------------------------------------------------
# Secrets — leave empty here; set via environment / secret manager
# ---------------------------------------------------------------------------
# Primary LLM key (optional in Phase 1; required for generation in later phases)
OPENAI_API_KEY=
# Alternative name accepted as fallback
KNOWLEDGEPILOT_OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Generation Providers (Phase 6)
# ---------------------------------------------------------------------------
# Generator provider: mock | ollama (default: mock)
KNOWLEDGEPILOT_GENERATOR_PROVIDER=mock

# Local Ollama endpoint and model (zero paid API keys required)
KNOWLEDGEPILOT_OLLAMA_BASE_URL=http://localhost:11434
KNOWLEDGEPILOT_OLLAMA_MODEL=llama3.2:1b
